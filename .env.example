# Copy this file to .env and update the values as needed.
# Variables set here are loaded automatically by Taskfile (dotenv directive).

# Dataset Builder — single episode conversion
# INPUT_MCAP=/workspace/data/processed_episodes/<date>/<uuid>/mcap/mcap_0.mcap
# DATASET_NAME=my-dataset
# DEPLOYMENT_DIR=/workspace/deployments/fr3_duo_example
# CLI_ARGS="--fps 20"

# Data paths (also used by docker volume mounts)
# DATA_ROOT=./data
# DEPLOYMENTS_ROOT=./deployments
