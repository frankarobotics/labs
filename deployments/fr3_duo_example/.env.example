# Copy this file to .env in the same directory as the docker-compose file / taskfile and update the values as needed.

# Set the data directory (if not set, defaults to: <repository_root>/data)
# DATA_ROOT=/absolute/path/to/data/directory

# Optional services to run on this station; see deployments/README.md
# COMPOSE_FILE=docker-compose.yml:docker-compose.nomadic.yml

# Nomadic annotations; see services/pipeline/nomadic-episode-annotator/README.md
# NOMADIC_API_KEY=
