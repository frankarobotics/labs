    context="../../services/actuators/robotiq-gripper",
    dockerfile="../../services/actuators/robotiq-gripper/robotiq-gripper.dockerfile",
    build_args=common_build_args,
    target="dev",
    # No live_update: purely a C++ ROS 2 service compiled at image build time.
    # Any changes require a full image rebuild.
)

docker_build(
    ref="registry.localhost/labs/zed-camera:latest",
    context="../../services/sensors/zed-camera",
    dockerfile="../../services/sensors/zed-camera/zed-camera.dockerfile",
    build_args=common_build_args,
    target="dev",
    live_update=[
        sync(
            "../../services/sensors/zed-camera/src",
            "/workspace/src",
        ),
        # Restart the process to pick up the changed files.
        # NOTE: Only Python files in src/ benefit from live_update.
        # C++ changes in the ZED ROS 2 wrapper or submodule commit updates will be synced but
        # NOT recompiled — a full image rebuild is required for those.
        restart_container(),
    ],
)

docker_build(
    ref="registry.localhost/labs/realsense-camera:latest",
