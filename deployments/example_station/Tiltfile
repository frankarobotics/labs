# Settings
# https://docs.tilt.dev/api.html
analytics_settings(enable=False)
ci_settings(timeout="30m")

docker_prune_settings(
    disable=True
)

update_settings(
    max_parallel_updates=10,
    k8s_upsert_timeout_secs=30,
    suppress_unused_image_warnings=None,
)

version_settings(check_updates=False)

docker_compose("docker-compose.yml")

git_commit = str(local("git -C ../../ rev-parse HEAD")).strip()
common_build_args = {"BUILD_TARGET": "dev", "BUILD_VERSION": git_commit, "GIT_COMMIT": git_commit}

# Docker builds
docker_build(
    ref="registry.localhost/labs/migrate:latest",
    context="../../services/pipeline/migrate",
    dockerfile="../../services/pipeline/migrate/migrate.dockerfile",
    build_args=common_build_args,
    target="dev",
    live_update=[
        sync(
            "../../services/pipeline/migrate/migrations",
            "/workspace/migrations",
        ),
        # No restart needed, one-shot job
    ],
)

docker_build(
    ref="registry.localhost/labs/data-collection:latest",
    context="../../services/pipeline/data-collection",
    dockerfile="../../services/pipeline/data-collection/data-collection.dockerfile",
    build_args=common_build_args,
    target="dev",
    live_update=[
        sync(
            "../../services/pipeline/data-collection/src",
            "/workspace/src",
        ),
        # Restart the process to pick up the changed files.
        restart_container(),
    ],
)

docker_build(
    ref="registry.localhost/labs/data-recorder:latest",
    context="../../services/pipeline/data-recorder",
    dockerfile="../../services/pipeline/data-recorder/data-recorder.dockerfile",
    build_args=common_build_args,
    target="dev",
    live_update=[
        sync(
            "../../services/pipeline/data-recorder/src",
            "/workspace/src",
        ),
        # Restart the process to pick up the changed files.
        restart_container(),
    ],
)

